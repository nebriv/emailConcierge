# IMAP (read-only, enforced in code)
#
# Two ways to configure mailboxes:
#   (a) Single-account: set the EMAIL_CONCIERGE_IMAP_* fields below.
#       The listener watches one mailbox. Simplest; preserved for
#       backward compat.
#   (b) Multi-account: set one EMAIL_CONCIERGE_ACCOUNT_<N> env var per
#       mailbox, each an IMAP connection URL (see below). One listener
#       thread spawns per entry. When *any* ACCOUNT_<N> var is set it
#       takes precedence and the IMAP_* fields below are ignored.
#
# Pick ONE.
#
# --- (a) single-account ---
EMAIL_CONCIERGE_IMAP_HOST=mail.example.com
EMAIL_CONCIERGE_IMAP_PORT=993
EMAIL_CONCIERGE_IMAP_USERNAME=user@example.com
EMAIL_CONCIERGE_IMAP_PASSWORD=app-password-here
EMAIL_CONCIERGE_IMAP_FOLDER=INBOX
EMAIL_CONCIERGE_IMAP_USE_SSL=true
EMAIL_CONCIERGE_IMAP_RECONNECT_SECONDS=30
#
# --- (b) multi-account (URL-per-var) ---
# Grammar:
#   imaps://<user>:<password>@<host>[:<port>]/<folder>#<name>
#   imap://...                                (same, but plaintext / default port 143)
#
# `<name>` (the URL fragment) is a short stable identifier tagged onto
# every processed_messages / training_examples row. Must be unique
# across all configured accounts.
#
# `<user>` and `<password>` must be URL-encoded if they contain '@', ':',
# '/', or '#'. Most commonly: an email address for the user ('@' → '%40'),
# and any password with shell-special characters.
#
# `<folder>` defaults to INBOX when the path is empty. Nested folders
# (e.g. Work/Projects) must percent-encode the slash: Work%2FProjects.
#
# Indices need not be contiguous — gaps are fine. ACCOUNT_1 before
# ACCOUNT_10 (numeric sort).
#
# Note: Gmail doesn't support IMAP IDLE push; the listener falls back to
# periodic re-fetch on the 29-minute timeout cycle. That's fine for a
# personal-mail scale inbox but don't expect sub-second latency on Gmail.
#
# Examples (uncomment to use):
# EMAIL_CONCIERGE_ACCOUNT_1=imaps://me%40example.com:app-password@mail.example.com/INBOX#personal
# EMAIL_CONCIERGE_ACCOUNT_2=imaps://me%40gmail.com:gmail-app-password@imap.gmail.com/INBOX#gmail

# Sender filtering (comma-separated)
EMAIL_CONCIERGE_SENDER_ALLOW=
EMAIL_CONCIERGE_SENDER_DENY=newsletter@,noreply@substack.com

# Pipeline
EMAIL_CONCIERGE_MIN_CONFIDENCE=0.7
EMAIL_CONCIERGE_CAN_HANDLE_FLOOR=0.5
EMAIL_CONCIERGE_DISABLED_PLUGINS=
EMAIL_CONCIERGE_DISABLE_LLM=false

# LLM (stage 4) -- any OpenAI-compatible endpoint: Ollama, RunPod, OpenRouter, etc.
# Default: local Ollama on the docker network.
EMAIL_CONCIERGE_LLM_BASE_URL=http://ollama:11434/v1
EMAIL_CONCIERGE_LLM_API_KEY=ollama
EMAIL_CONCIERGE_LLM_MODEL=llama3.2:3b
# RunPod cold-starts can take 30-60s on the first request; 180 is safe.
EMAIL_CONCIERGE_LLM_TIMEOUT_SECONDS=60

# --- RunPod serverless vLLM (alternative to Ollama) -------------------------
# 1. Deploy a vLLM worker from the RunPod console. On the endpoint's env vars:
#      MODEL_NAME=qwen/qwen3-8b        (or any instruct-tuned chat model)
#      RAW_OPENAI_OUTPUT=true          (REQUIRED: surfaces the OpenAI proxy)
#      OPENAI_RESPONSE_ROLE=assistant
#      ENABLE_AUTO_TOOL_CHOICE=false
# 2. Copy the endpoint ID (shown as e.g. `u3jjnbxufp0szl`) and an API key.
# 3. Point the three LLM env vars above at it:
#      EMAIL_CONCIERGE_LLM_BASE_URL=https://api.runpod.ai/v2/<ENDPOINT_ID>/openai/v1
#      EMAIL_CONCIERGE_LLM_API_KEY=<runpod-api-key>
#      EMAIL_CONCIERGE_LLM_MODEL=qwen/qwen3-8b
#      EMAIL_CONCIERGE_LLM_TIMEOUT_SECONDS=180
# FlashBoot typically brings cold-start down to ~2s after the first request.
# `response_format={"type":"json_object"}` is honored by vLLM's guided decoder,
# so no code changes are needed relative to the Ollama path.

# NER (stage 3) -- reserved for Phase 5; unused in v1.0 Phase 1
EMAIL_CONCIERGE_GLINER_MODEL=urchade/gliner_small-v2.1
EMAIL_CONCIERGE_CLASSIFIER_PATH=/data/models/classifier.pkl
EMAIL_CONCIERGE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# CalDAV
EMAIL_CONCIERGE_CALDAV_URL=https://nextcloud.home.example.com/remote.php/dav/calendars/user/
EMAIL_CONCIERGE_CALDAV_USERNAME=user
EMAIL_CONCIERGE_CALDAV_PASSWORD=app-password
EMAIL_CONCIERGE_CALDAV_CALENDAR=auto-imported

# Behavior
EMAIL_CONCIERGE_USER_TIMEZONE=America/New_York
EMAIL_CONCIERGE_DRY_RUN=false
EMAIL_CONCIERGE_FEEDBACK_WINDOW_HOURS=24

# Storage
EMAIL_CONCIERGE_DB_PATH=/data/email-concierge.db
EMAIL_CONCIERGE_MODELS_DIR=/data/models

# Logging
EMAIL_CONCIERGE_LOG_LEVEL=INFO
EMAIL_CONCIERGE_LOG_JSON=true
